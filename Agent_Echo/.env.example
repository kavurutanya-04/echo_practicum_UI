# Configuration reference only; this example file is NOT automatically loaded.
# Copy this template to .env only if a private .env does not already exist.
# Live clients read keys, endpoints, deployments/models and API versions from .env.
# Existing environment variables take precedence. Never commit real values.
# Profile selection stays in connections.json or terminal ECHO_*_PROFILE variables.

# PRIMARY / FINAL PROVIDER: GW Azure AI Foundry.
# Use ONLY your group's assigned endpoint and key. Obtain the deployment name
# from your group's sandbox/guide; the resource name alone is not a model name.
# Endpoint format: https://YOUR-ASSIGNED-RESOURCE.openai.azure.com/
GW_AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Optional, only for semantic/hybrid retrieval using the GW embedding deployment.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# OPTIONAL TEST CONNECTIONS: these are not selected by default.
# Optional personal OpenAI model profile.
OPENAI_MODEL=
OPENAI_API_KEY=

# Optional Google testing profile; use a tool-capable model available to your account.
GOOGLE_MODEL=
GOOGLE_API_KEY=

# NVIDIA and OpenCode models/endpoints are already configured in connections.json.
# A collaborator can copy this template to .env locally and paste their own keys there.
# NVIDIA_API_KEY is shared by nvidia_test (Nemotron) and nvidia_glm_test (GLM).
# Paste keys into the private .env, not this shared example file.
NVIDIA_API_KEY=
# OpenCode free access was rejected for external Python calls (403 FreeTierError).
# Keep this as a connection reference; it is not a working free API for Echo.
OPENCODE_API_KEY=
# Optional local/terminal overrides: NVIDIA_MODEL, NVIDIA_GLM_MODEL, NVIDIA_BASE_URL,
# OPENCODE_MODEL, OPENCODE_BASE_URL.
# Select --profile nvidia_test, nvidia_glm_test or opencode_test when running Echo.

# Embedding models are separate from text-generation models.
GOOGLE_EMBEDDING_MODEL=
OPENAI_EMBEDDING_MODEL=
