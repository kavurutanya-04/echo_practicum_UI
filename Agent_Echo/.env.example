# Configuration reference only; this example file is NOT automatically loaded.
# Live clients can read API keys from a private .env beside connections.json.
# Only API keys are read from .env; set other overrides in the terminal or connections.json.
# Existing environment keys take precedence. Never commit real keys.
# Agent configuration is in connections.json, with optional profile overrides below.
ECHO_DEFAULT_PROFILE=gw_azure
# ECHO_CHERRY_PROFILE=google_test
# ECHO_VANILLA_PROFILE=google_test
# ECHO_LIME_PROFILE=google_test
# ECHO_ORIGINAL_PROFILE=google_test
# ECHO_ZEROSUGAR_PROFILE=personal_openai
AZURE_OPENAI_ENDPOINT=https://YOUR-ASSIGNED-RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR-RESPONSES-CAPABLE-DEPLOYMENT
AZURE_OPENAI_API_VERSION=2025-03-01-preview
GW_AZURE_OPENAI_KEY=

# Optional personal OpenAI model profile.
OPENAI_MODEL=
OPENAI_API_KEY=

# Optional Google testing profile; use a tool-capable model available to your account.
GOOGLE_MODEL=
GOOGLE_API_KEY=

# NVIDIA and OpenCode models/endpoints are already configured in connections.json.
# A collaborator can copy this template to .env locally and paste their own keys there.
# NVIDIA_API_KEY is shared by nvidia_test (Nemotron) and nvidia_glm_test (GLM).
# Paste keys into the private .env, not this shared example file.
NVIDIA_API_KEY=
OPENCODE_API_KEY=
# Optional terminal overrides: NVIDIA_MODEL, NVIDIA_GLM_MODEL, NVIDIA_BASE_URL,
# OPENCODE_MODEL, OPENCODE_BASE_URL.
# Select --profile nvidia_test, nvidia_glm_test or opencode_test when running Echo.

# Embedding deployments/models are separate from text-generation deployments/models.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
GOOGLE_EMBEDDING_MODEL=
OPENAI_EMBEDDING_MODEL=
