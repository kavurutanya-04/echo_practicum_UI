{
  "default_profile": "gw_azure",
  "agents": {
    "Original": null,
    "Cherry": null,
    "Vanilla": null,
    "Lime": null,
    "ZeroSugar": null
  },
  "retrieval": {"mode": "lexical", "embedding_profile": "gw_embeddings"},
  "profiles": {
    "gw_azure": {
      "description": "Primary final provider: use only the group's GW-assigned Azure resource.",
      "provider": "azure", "api": "responses", "azure_api": "legacy",
      "model_env": "AZURE_OPENAI_DEPLOYMENT", "endpoint_env": "AZURE_OPENAI_ENDPOINT",
      "key_env": "GW_AZURE_OPENAI_KEY", "api_version_env": "AZURE_OPENAI_API_VERSION"
    },
    "google_test": {
      "provider": "google", "api": "chat",
      "model_env": "GOOGLE_MODEL", "key_env": "GOOGLE_API_KEY"
    },
    "personal_openai": {
      "provider": "openai", "api": "responses",
      "model_env": "OPENAI_MODEL", "key_env": "OPENAI_API_KEY"
    },
    "nvidia_test": {
      "provider": "openai_compatible", "api": "chat",
      "endpoint": "https://integrate.api.nvidia.com/v1",
      "endpoint_env": "NVIDIA_BASE_URL",
      "model": "nvidia/nemotron-3-ultra-550b-a55b", "model_env": "NVIDIA_MODEL",
      "key_env": "NVIDIA_API_KEY", "max_output_tokens": 8192
    },
    "nvidia_glm_test": {
      "provider": "openai_compatible", "api": "chat",
      "endpoint": "https://integrate.api.nvidia.com/v1",
      "endpoint_env": "NVIDIA_BASE_URL",
      "model": "z-ai/glm-5.3-flash", "model_env": "NVIDIA_GLM_MODEL",
      "key_env": "NVIDIA_API_KEY", "max_output_tokens": 8192,
      "reasoning_effort": "low", "clear_thinking": true
    },
    "opencode_test": {
      "provider": "openai_compatible", "api": "chat",
      "endpoint": "https://opencode.ai/inference/openai/v1",
      "endpoint_env": "OPENCODE_BASE_URL",
      "model": "deepseek-v4.1-flash-free", "model_env": "OPENCODE_MODEL",
      "key_env": "OPENCODE_API_KEY", "max_output_tokens": 8192
    },
    "gw_embeddings": {
      "description": "Optional embeddings using the same GW-assigned resource and key.",
      "provider": "azure", "api": "embeddings", "azure_api": "legacy",
      "model_env": "AZURE_OPENAI_EMBEDDING_DEPLOYMENT", "endpoint_env": "AZURE_OPENAI_ENDPOINT",
      "key_env": "GW_AZURE_OPENAI_KEY", "api_version_env": "AZURE_OPENAI_API_VERSION"
    },
    "google_embeddings": {
      "provider": "google", "api": "embeddings",
      "model_env": "GOOGLE_EMBEDDING_MODEL", "key_env": "GOOGLE_API_KEY"
    },
    "openai_embeddings": {
      "provider": "openai", "api": "embeddings",
      "model_env": "OPENAI_EMBEDDING_MODEL", "key_env": "OPENAI_API_KEY"
    }
  }
}
